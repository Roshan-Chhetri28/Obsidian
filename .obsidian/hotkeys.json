{
  "editor:toggle-highlight": [
    {
      "modifiers": [
        "Mod"
      ],
      "key": "H"
    }
  ],
  "editor:swap-line-up": [
    {
      "modifiers": [
        "Alt"
      ],
      "key": "ArrowUp"
    }
  ],
  "editor:swap-line-down": [
    {
      "modifiers": [
        "Alt"
      ],
      "key": "ArrowDown"
    }
  ],
  "obsidian-git:push": [
    {
      "modifiers": [
        "Mod",
        "Shift"
      ],
      "key": "Enter"
    }
  ],
  "editor:indent-list": [
    {
      "modifiers": [
        "Alt"
      ],
      "key": "Tab"
    }
  ]
}