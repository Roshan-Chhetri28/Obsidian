{
  "editor:toggle-highlight": [
    {
      "modifiers": [
        "Mod"
      ],
      "key": "H"
    }
  ],
  "editor:swap-line-up": [
    {
      "modifiers": [
        "Alt"
      ],
      "key": "ArrowUp"
    }
  ],
  "editor:swap-line-down": [
    {
      "modifiers": [
        "Alt"
      ],
      "key": "ArrowDown"
    }
  ],
  "obsidian-git:push": [
    {
      "modifiers": [
        "Mod",
        "Shift"
      ],
      "key": "Enter"
    }
  ],
  "editor:indent-list": [
    {
      "modifiers": [
        "Mod"
      ],
      "key": "]"
    }
  ],
  "window:zoom-in": [
    {
      "modifiers": [
        "Mod"
      ],
      "key": "="
    }
  ],
  "window:zoom-out": [
    {
      "modifiers": [
        "Mod"
      ],
      "key": "-"
    }
  ]
